# 复制为 .env 后按需修改；不填则使用仓库默认值（下方即为默认值）
# 本文件只包含运行参数，没有任何密钥；项目不需要任何凭证即可离线运行。

# 数据周期：至少 13 个完整月才能计算同比，否则 metrics 阶段会直接报错
KPI_START_DATE=2024-01-01
KPI_END_DATE=2025-08-31

# 随机种子：固定后重复运行得到逐字节一致的数据
KPI_SEED=20260101

# 产物路径（相对仓库根目录，也可写绝对路径）
KPI_DATA_DIR=data
KPI_DASHBOARD_DIR=dashboard

# 日志级别：DEBUG / INFO / WARNING / ERROR
KPI_LOG_LEVEL=INFO
